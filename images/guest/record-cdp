#!/bin/sh
set -eu
# Capture a live CDP tab, then atomically publish only a probed MP4.
usage() {
    cat <<'HELP'
usage: record-cdp [--seconds N] [--target ID] NAME

Record an existing CDP tab as /artifacts/NAME.mp4 and its first frame as NAME.png.
N is an integer from 1 to 30 (default 30); NAME is an ASCII flat file stem of
at most 124 characters, beginning with an alphanumeric, without a .mp4 suffix.
The last tab is recorded unless --target selects a CDP target ID (used by browse).
Use browse record NAME [--seconds N] for browse's current tab (default 10 seconds).
Recordings longer than the exec deadline return a job to poll before attaching files.
HELP
}
name=
seconds=30
target=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --seconds|--target)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then usage >&2; exit 2; fi
            case "$1" in --seconds) seconds=$2 ;; --target) target=$2 ;; esac
            shift 2 ;;
        -*) usage >&2; exit 2 ;;
        *)
            if [ -n "$name" ] || [ -z "$1" ]; then usage >&2; exit 2; fi
            name=$1
            shift ;;
    esac
done
export LC_ALL=C
case "$name" in
    [!a-zA-Z0-9]*|*[!a-zA-Z0-9._-]*|*.mp4|'')
        echo 'record NAME must be a flat file stem of at most 124 characters, without .mp4' >&2; exit 2 ;;
esac
if [ "${#name}" -gt 124 ]; then
    echo 'record NAME must be a flat file stem of at most 124 characters, without .mp4' >&2; exit 2
fi
case "$seconds" in
    [1-9]|[12][0-9]|30) ;;
    *) echo 'record --seconds must be an integer from 1 to 30' >&2; exit 2 ;;
esac
artifacts=${BROWSE_ARTIFACTS:-/artifacts}
work=$(mktemp -d /scratch/recordings/.record.XXXXXX)
trap 'rm -rf "$work"' EXIT HUP INT TERM
node - "$work" "$seconds" "$target" <<'JS'
const {chromium} = require(process.env.BROWSE_PLAYWRIGHT || '/opt/playwright/node_modules/playwright');
const fs = require('node:fs');
const path = require('node:path');
(async () => {
  const seconds = Number(process.argv[3]);
  const target = process.argv[4];
  const browser = await chromium.connectOverCDP(`http://127.0.0.1:${process.env.BROWSE_PORT || 9222}`, {timeout:30000});
  let page;
  let cdp;
  try {
    const pages = browser.contexts()[0].pages();
    if (!target) page = pages.at(-1);
    else for (const candidate of pages) {
      const session = await candidate.context().newCDPSession(candidate);
      try {
        if ((await session.send('Target.getTargetInfo')).targetInfo.targetId === target) page = candidate;
      } finally {
        await session.detach().catch(() => {});
      }
    }
    if (!page) throw new Error(target ? `no CDP target ${target}` : 'no CDP tab to record');
    await page.setViewportSize({width:1280, height:720});
    cdp = await page.context().newCDPSession(page);
    await cdp.send('Page.enable');
    let count = 0;
    const frameElapsed = [];
    const started = performance.now();
    await page.evaluate(() => {
      const marker = document.createElement('div');
      marker.dataset.cdpRecording = 'true';
      marker.style.cssText = 'position:fixed;top:0;left:0;background:#174b72;color:white;z-index:2147483647';
      (document.body || document.documentElement).append(marker);
      let n = 0;
      window.recordTimer = setInterval(() => {
        marker.textContent = `CDP proof frame ${++n}`;
      }, 1000);
    });
    await new Promise((resolve, reject) => {
      const limit = setTimeout(() => reject(new Error(`screencast stalled at ${count}/${seconds} frames`)), 55000);
      cdp.on('Page.screencastFrame', async ({data, sessionId}) => {
        try {
          const elapsed = Math.round(performance.now() - started);
          if (count < seconds && elapsed >= (count + 1) * 1000 &&
              (count === 0 || elapsed - frameElapsed.at(-1) >= 500)) {
            fs.writeFileSync(path.join(process.argv[2], `frame${String(count++).padStart(2,'0')}.png`), Buffer.from(data, 'base64'));
            frameElapsed.push(elapsed);
          }
          await cdp.send('Page.screencastFrameAck', {sessionId});
          if (count === seconds) { clearTimeout(limit); resolve(); }
        } catch (error) { clearTimeout(limit); reject(error); }
      });
      cdp.send('Page.startScreencast', {format:'png', everyNthFrame:1}).catch(error => { clearTimeout(limit); reject(error); });
    });
    console.log(`CDP_FRAME_ELAPSED_MS=${frameElapsed.join(',')}`);
    console.log(`CDP_CAPTURE_ELAPSED_MS=${Math.round(performance.now() - started)}`);
  } finally {
    if (cdp) {
      cdp.removeAllListeners('Page.screencastFrame');
      await cdp.send('Page.stopScreencast').catch(() => {});
      await page.evaluate(() => {
        clearInterval(window.recordTimer);
        document.querySelectorAll('[data-cdp-recording]').forEach((e) => e.remove());
      }).catch(() => {});
      await cdp.detach().catch(() => {});
    }
    await browser.close().catch(() => {});
  }
})().catch(e => { console.error(e); process.exit(1); });
JS
cp "$work/frame00.png" "$work/preview.png"
grep -E 'MemTotal|MemFree|MemAvailable' /proc/meminfo
grep oom_kill /proc/vmstat
ffmpeg -hide_banner -loglevel error -framerate 1 -i "$work/frame%02d.png" \
    -c:v libx264 -threads 1 -pix_fmt yuv420p -r 30 -movflags +faststart "$work/output.mp4"
grep -E 'MemTotal|MemFree|MemAvailable' /proc/meminfo
grep oom_kill /proc/vmstat
ffprobe -v error -show_entries format=duration,size -show_entries stream=codec_name,width,height -of json "$work/output.mp4"
python3 - "$work/output.mp4" <<'PY'
import sys
with open(sys.argv[1], 'rb') as f:
    p = f.read(1 << 20)
assert p.index(b'moov') < p.index(b'mdat')
PY
python3 - "$work" "$name" "$artifacts" <<'PY'
import os, shutil, sys
work, name, artifacts = sys.argv[1:]
dir_fd = os.open(artifacts, os.O_RDONLY | os.O_DIRECTORY)
try:
    for src, dst in (('output.mp4', f'{name}.mp4'), ('preview.png', f'{name}.png')):
        fd = os.open(artifacts, os.O_TMPFILE | os.O_WRONLY, 0o644)
        with open(os.path.join(work, src), 'rb') as f, os.fdopen(fd, 'wb') as out:
            shutil.copyfileobj(f, out)
            out.flush()
            os.fsync(fd)
            os.link(f'/proc/self/fd/{fd}', dst, dst_dir_fd=dir_fd)
finally:
    os.close(dir_fd)
PY
printf 'published %s/%s.mp4 and matching PNG\n' "$artifacts" "$name"
