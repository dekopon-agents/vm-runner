#!/bin/sh
set -eu
# Guest exec clears its environment. Always use the baked interpreter, never download one.
export UV_PYTHON=/usr/bin/python3
export UV_PYTHON_PREFERENCE=only-system
export UV_PYTHON_DOWNLOADS=never
export UV_CACHE_DIR="${UV_CACHE_DIR:-/home/jail/.cache/uv}"
exec /usr/local/bin/uv-native "$@"
