#!/bin/sh
set -eu

if [ "${1:-}" != '--overlay' ]; then
    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -t devtmpfs devtmpfs /dev
    mount -t ext4 /dev/vdc /scratch
    mkdir -p /scratch/upper /scratch/work
    mount -t overlay overlay -o lowerdir=/,upperdir=/scratch/upper,workdir=/scratch/work /newroot
    mount --move /scratch /newroot/scratch
    mount --move /proc /newroot/proc
    mount --move /sys /newroot/sys
    mount --move /dev /newroot/dev
    cd /newroot
    pivot_root . oldroot
    exec chroot . /sbin/vm-init --overlay
fi

umount -l /oldroot
mkdir -p /dev/pts /dev/shm /scratch/artifacts /home/jail/.pki/nssdb /run
mount -t devpts devpts /dev/pts -o gid=5,mode=620
mount -t tmpfs tmpfs /dev/shm -o mode=1777
mount -t tmpfs tmpfs /run
mount --bind /scratch/artifacts /artifacts
chown 1000:1000 /artifacts
openssl x509 -in /dev/vdb -out /usr/local/share/ca-certificates/vm-runner.crt
update-ca-certificates
certutil -N --empty-password -d sql:/home/jail/.pki/nssdb
certutil -A -d sql:/home/jail/.pki/nssdb -n vm-runner -t 'C,,' \
    -i /usr/local/share/ca-certificates/vm-runner.crt
chown -R 1000:1000 /home/jail/.pki
export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/vm-runner.crt
ip link set lo up
ip addr add 10.0.2.2/30 dev eth0
ip link set eth0 up
ip route add default via 10.0.2.1 dev eth0
printf 'nameserver 10.0.2.1\n' > /etc/resolv.conf
exec /usr/bin/tini -- /usr/local/bin/vm-guest-agent
